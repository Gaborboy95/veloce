# Copy to .env. Process environment values override this file.
VELOCE_CAN_INPUT=memory
VELOCE_CAN_BUS=comfort
VELOCE_CAN_WRITE_ENABLED=false

# Linux SocketCAN:
# VELOCE_CAN_INPUT=socketcan
# VELOCE_SOCKETCAN_INTERFACE=can0

# Windows LAWICEL/SLCAN:
# VELOCE_CAN_INPUT=lawicel
# VELOCE_LAWICEL_PORT=COM3
# VELOCE_LAWICEL_SERIAL_BAUD=115200
# VELOCE_CAN_BITRATE=500000

# Optional paths:
# VELOCE_PLUGIN_DIR=C:/path/to/plugins
# VELOCE_PLUGIN_STORAGE=C:/path/to/storage
# VELOCE_LUA_LIBRARY=C:/path/to/veloce_lua_native.dll
